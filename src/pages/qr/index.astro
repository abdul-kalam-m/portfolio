---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getProjects, projectHref } from '../../lib/projects';
import { qrSvgForPath, inlineQr } from '../../lib/qr';
import { absoluteUrl, OWNER } from '../../lib/site';

/**
 * QR hub (§9.3): every project, the résumé, and the site root, each with its code.
 * The owner opens this page to show a code in person, and it prints black on white.
 */

const projects = await getProjects();

const entries = await Promise.all(
  [
    { slug: 'site', title: `${OWNER.name} — portfolio`, path: '/', kind: 'Site' },
    { slug: 'resume', title: 'Résumé', path: '/resume/', kind: 'Document' },
    ...projects.map((project) => ({
      slug: project.id,
      title: project.data.title,
      path: projectHref(project),
      kind: 'Project',
    })),
  ].map(async (entry) => ({
    ...entry,
    svg: inlineQr(await qrSvgForPath(entry.path)),
    url: absoluteUrl(entry.path),
  }))
);
---

<BaseLayout
  title="QR codes"
  description="Scannable QR codes for every project page, the résumé, and the site root — printable black on white for posters and conferences."
  path="/qr/"
  image="/og/qr.png"
  bodyClass="qr-page"
>
  <div class="print:hidden">
    <PageHeader
      eyebrow="Share"
      title="QR codes"
      lead="Every page on this site has a code that resolves to its canonical URL. Open this page to show one in person, or print it — the print stylesheet drops to black on white and hides everything that is not a code."
    />
  </div>

  <div class="print-head" aria-hidden="true">
    <p>{OWNER.fullName} — {OWNER.email}</p>
  </div>

  <div class="container-page grid-wrap">
    <ul class="grid">
      {
        entries.map((entry) => (
          <li class="item">
            <div class="plate">
              <Fragment set:html={entry.svg} />
            </div>
            <p class="title">{entry.title}</p>
            <p class="kind print:hidden">{entry.kind}</p>
            <p class="url tnum">{entry.url}</p>
            <p class="download print:hidden">
              <a href={`/qr/${entry.slug}.svg`} download={`qr-${entry.slug}.svg`}>
                Download SVG
              </a>
            </p>
          </li>
        ))
      }
    </ul>

    <p class="note print:hidden">
      Codes use error-correction level Q with the standard four-module quiet zone, so they survive
      print wear and partial occlusion, and scan reliably from about 3 cm square at arm&rsquo;s
      length. They always render black on white in both themes — a re-themed QR is a QR that fails
      to scan.
    </p>
  </div>
</BaseLayout>

<style>
  .print-head {
    display: none;
  }

  .grid-wrap {
    padding-block: var(--space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .plate {
    background-color: #ffffff;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .plate :global(svg) {
    width: 100%;
    height: auto;
    display: block;
  }

  .title {
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .kind {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .url {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .download {
    font-size: var(--text-xs);
  }

  .note {
    margin-top: var(--space-10);
    max-width: var(--width-prose);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  @media print {
    .print-head {
      display: block;
      padding: 0 0 var(--space-4);
      border-bottom: 1px solid #000000;
      font-size: 10pt;
    }

    .grid-wrap {
      padding-block: var(--space-4);
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }

    .item {
      break-inside: avoid;
    }

    .plate {
      border-color: #000000;
    }
  }
</style>

<style is:global>
  @media print {
    /* Site chrome is noise on a printed sheet of codes (§9.3). */
    .qr-page header.site-header,
    .qr-page footer.site-footer,
    .qr-page .skip-link {
      display: none !important;
    }
  }
</style>
