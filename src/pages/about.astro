---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { OWNER, RESUME } from '../lib/site';
import { personJsonLd } from '../lib/seo';

/*
  DRAFT: owner review — bio and skills transcribed from the résumé PDF (§13.5.7 locks
  these facts, so nothing here is invented; anything unsupported by the PDF is omitted).
*/

const skills = [
  {
    group: 'GIS and spatial analysis',
    items: ['ArcGIS', 'QGIS', 'PostGIS', 'Google Earth', 'Coordinate system transformations'],
  },
  {
    group: 'Python for geospatial data science',
    items: ['GeoPandas', 'Rasterio', 'GDAL', 'Pyproj', 'NumPy', 'Pandas', 'Xarray', 'HyRiver'],
  },
  {
    group: 'Remote sensing and climate modeling',
    items: [
      'NDVI analysis',
      'Land use / land cover classification',
      'EPA SWMM',
      'Hydrological impact modeling',
    ],
  },
  {
    group: 'Machine learning for risk assessment',
    items: ['Scikit-learn', 'K-means', 'DBSCAN', 'Random forest', 'LSTM', 'CNN', 'TensorFlow'],
  },
  {
    group: 'Big data and cloud GIS',
    items: ['Google Earth Engine', 'OpenStreetMap API', 'US Census API', 'PUMS datasets'],
  },
  {
    group: 'Visualization and communication',
    items: [
      'Tableau',
      'Power BI',
      'ArcGIS StoryMaps',
      'Jupyter',
      'Policy briefs',
      'Stakeholder engagement',
    ],
  },
];

const education = [
  {
    school: 'Rutgers University',
    period: 'Expected',
    lines: [
      'Master of Public Informatics — GIS and spatial data analysis',
      'Master of City Planning — environmental and climate change planning',
    ],
  },
  {
    school: 'Anna University',
    period: '2016–2021',
    lines: ['Bachelor of Architecture — architecture and urban design'],
  },
];
---

<BaseLayout
  title="About"
  description="Geospatial data analyst and urban planner working on climate resilience, risk modeling, and spatial analysis in New Jersey and Chennai."
  path="/about/"
  image="/og/about.png"
  jsonLd={[personJsonLd()]}
>
  <PageHeader
    eyebrow="About"
    title="I work between the map and the decision."
    lead="Geospatial data analyst and urban planner with 3+ years of experience in climate resilience, risk modeling, and GIS-based hazard assessment — and a licensed architect, which is why the physical form of a place keeps showing up in the analysis."
  />

  <div class="container-page layout">
    <Prose class="bio">
      <h2>What I do</h2>
      <p>
        Most of my work starts with the same problem: a decision needs evidence, and the evidence is
        spread across a hazard layer, an assessment roll, a census table, and a forecast API that
        were never designed to talk to each other. I build the thing in the middle — the pipeline,
        the score with its drivers visible, the map that answers one stated question.
      </p>
      <p>
        In Chennai I led hydrological GIS modeling for flood resilience, co-authored a sponge park
        handbook that prioritised 1,000 sites through a spatial framework, and ran the analysis
        behind mitigation strategies that lifted a 180-acre flood-prone area from 2-year to 5-year
        return-period protection. At Rutgers CLiME I work on housing affordability and rent burden
        across New Jersey, automating the extraction of certificates of occupancy, building permits,
        and demographics so the analysis can be rerun rather than redone.
      </p>
      <p>
        The AI work grew out of frustration rather than enthusiasm. A language model will make you a
        map with confident, indefensible classification breaks. That is a validation problem, not a
        modeling problem, and it turns out to be a much more interesting one.
      </p>

      <h2>How I work</h2>
      <ul>
        <li>
          <strong>Numbers carry their provenance.</strong> Every figure on this site traces to a committed
          output in the repository that produced it. Where a project has no results yet, it says so on
          the card and on the page.
        </li>
        <li>
          <strong>Reproducible by default.</strong> If it cannot be rerun from a script, it is a screenshot,
          not an analysis.
        </li>
        <li>
          <strong>Limitations get written down.</strong> The honest failure case is more useful to a reader
          than a clean result, and it is the part most portfolios omit.
        </li>
      </ul>

      <h2>Recognition</h2>
      <p>
        Winner of the Chennai Lakefront Rejuvenation Competition (CMDA, 2023). Nominated for the
        National Awards for Excellence in Architectural Thesis (Council of Architecture, 2022) and
        the JK AYA Best Architecture Student of the Year Award. Licensed architect, Council of
        Architecture, India — CA/2023/158480.
      </p>
    </Prose>

    <aside class="side">
      <section class="card surface-card">
        <h2>Education</h2>
        {
          education.map((entry) => (
            <div class="edu">
              <p class="edu-school">
                {entry.school} <span class="edu-period tnum">{entry.period}</span>
              </p>
              <ul>
                {entry.lines.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="card surface-card">
        <h2>Skills</h2>
        {
          skills.map((skill) => (
            <div class="skill">
              <p class="skill-group">{skill.group}</p>
              <p class="skill-items">{skill.items.join(' · ')}</p>
            </div>
          ))
        }
      </section>

      <section class="card surface-card">
        <h2>Elsewhere</h2>
        <ul class="links">
          <li><a href={RESUME.href}>{RESUME.label}</a></li>
          <li><a href="/resume/">Résumé as a web page</a></li>
          <li><a href={OWNER.github} rel="me noopener">GitHub</a></li>
          <li><a href={OWNER.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href={`mailto:${OWNER.email}`}>{OWNER.email}</a></li>
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
    padding-block: var(--space-12);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-16);
    }
  }

  .side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .card {
    padding: var(--space-5);
  }

  .card h2 {
    font-size: var(--text-xs);
    font-weight: 620;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .edu,
  .skill {
    margin-top: var(--space-4);
  }

  .edu-school,
  .skill-group {
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .edu-period {
    font-weight: 400;
    color: var(--color-text-subtle);
  }

  .edu ul {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
  }

  .edu li,
  .skill-items {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .skill-items {
    margin-top: var(--space-1);
  }

  .links {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    overflow-wrap: anywhere;
  }
</style>
