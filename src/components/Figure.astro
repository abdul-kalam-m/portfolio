---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Every image and chart with a caption (§5.1). Dimensions are always set (no CLS, §8.1)
 * and below-the-fold figures lazy-load.
 *
 * §7.1: a map's caption states the question it answers. §7.3: a chart's caption states
 * the takeaway. `source` carries the citation line every map and chart must have.
 */

interface Props {
  src: ImageMetadata;
  /** Descriptive alt. Use `alt=""` only when the figure is genuinely decorative (§8.1) — rare. */
  alt: string;
  caption?: string;
  /** Source / citation line rendered under the caption (§7.1, §7.3). */
  source?: string;
  width?: number;
  /** `full` breaks out of the prose measure for wide artifacts. */
  variant?: 'prose' | 'full';
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  caption,
  source,
  width = 1200,
  variant = 'prose',
  loading = 'lazy',
} = Astro.props;
---

<figure class:list={['figure', variant === 'full' && 'breakout']} data-variant={variant}>
  <div class="frame">
    <Image
      src={src}
      alt={alt}
      width={width}
      densities={[1, 2]}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
    />
  </div>
  {
    (caption || source) && (
      <figcaption>
        {caption && <span class="caption">{caption}</span>}
        {source && <span class="source">{source}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure {
    margin: var(--space-8) 0;
  }

  .frame {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .source {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  /* Wide artifacts break the measure but never the page — see `.breakout` (§8.5). */
</style>
