---
/** Breadcrumb on project pages: `Section name → Project title` (§2.3). */

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  crumbs: Crumb[];
  /** The current page's own title; rendered as plain text, not a link. */
  current: string;
}

const { crumbs, current } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((crumb) => (
        <li>
          <a href={crumb.href}>{crumb.name}</a>
          <span class="sep" aria-hidden="true">
            /
          </span>
        </li>
      ))
    }
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .sep {
    color: var(--color-border-strong);
  }

  [aria-current='page'] {
    color: var(--color-text);
  }
</style>
