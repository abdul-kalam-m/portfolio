---
/**
 * Markdown/MDX typography wrapper (§5.1). Enforces the 60–75ch measure (§4.3) and a
 * single heading rhythm so case studies never grow one-off type styles (§5.2.1).
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: var(--width-prose);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-text);
  }

  .prose :global(> * + *) {
    margin-top: var(--space-5);
  }

  .prose :global(h2) {
    margin-top: var(--space-12);
    font-size: var(--text-2xl);
    scroll-margin-top: var(--space-16);
  }

  .prose :global(h3) {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
    scroll-margin-top: var(--space-16);
  }

  .prose :global(h4) {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
  }

  .prose :global(p) {
    text-wrap: pretty;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(li::marker) {
    color: var(--color-text-subtle);
  }

  .prose :global(strong) {
    font-weight: 640;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-muted);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  .prose :global(pre) {
    padding: var(--space-4);
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    font-size: var(--text-sm);
  }

  .prose :global(pre code) {
    padding: 0;
    border: none;
    background: none;
  }

  /*
   * Markdown tables have no wrapper to scroll inside, so the table itself becomes the
   * scroll container. Without this a wide table pushes the whole page sideways at 320px
   * (§8.5: wide artifacts scroll within their own container, never the page).
   */
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border);
    white-space: normal;
  }

  .prose :global(thead th) {
    background-color: var(--color-surface-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .prose :global(hr) {
    margin-block: var(--space-10);
    border: none;
    border-top: 1px solid var(--color-border);
  }

  /* Shiki emits both themes; show the one matching the active theme. */
  .prose :global(.astro-code) {
    background-color: var(--color-surface-2) !important;
  }

  :global(:root[data-theme='dark']) .prose :global(.astro-code),
  :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--color-surface-2) !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .prose :global(.astro-code),
    :global(:root:not([data-theme='light'])) .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
      background-color: var(--color-surface-2) !important;
    }
  }

  /*
   * Both GitHub themes paint comments #6A737D, which lands at 4.26:1 on our light code
   * surface and 3.33:1 on the dark one — under the §8.3 AA floor, and comment text is the
   * part of a snippet a reader most needs. Shiki writes token colors as inline styles, so
   * an attribute-matched !important override is the only thing that wins. Replacement
   * values are contrast-checked against --color-surface-2 in both themes.
   */
  .prose :global(.astro-code span[style*='#6A737D']) {
    color: #5a6169 !important;
  }

  :global(:root[data-theme='dark']) .prose :global(.astro-code span[style*='#6A737D']) {
    color: #8b949e !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .prose :global(.astro-code span[style*='#6A737D']) {
      color: #8b949e !important;
    }
  }
</style>
